# ==============================================================================
# Apache Web Server Rules for Urban Office
# Handles Clean SEO URLs, Gzip compression, and Security Headers
# ==============================================================================

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# Set Directory Index
DirectoryIndex index.php index.html

# Prevent Directory Browsing and disable MultiViews
Options -Indexes -MultiViews

# 1. Dynamic Sitemap Routing
# Rewrites /sitemap.xml to /sitemap.php dynamically
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 2. Dynamic Blog Article Clean URL mappings
# Rewrites /blog/post-slug/ to /blog/article.php?slug=post-slug
RewriteRule ^blog/([a-zA-Z0-9\-]+)/?$ blog/article.php?slug=$1 [L,QSA]

# 2.5 Dynamic Location Detail mappings
# Rewrites /lokasi-urban-office/location-slug/ to /lokasi-urban-office/detail.php?slug=location-slug
RewriteRule ^lokasi-urban-office/([a-zA-Z0-9\-]+)/?$ lokasi-urban-office/detail.php?slug=$1 [L,QSA]

# 2.6 Dynamic Virtual Office Branch Landing Page mappings
# Rewrites /virtual-office-branch-slug/ to /virtual-office-surabaya/index.php?branch=branch-slug
# virtual-office-surabaya/ itself is a real folder (represents the MERR branch) and is
# excluded via the -d check below so it keeps being served directly, unaffected by this rule.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^virtual-office-([a-zA-Z0-9\-]+)/?$ virtual-office-surabaya/index.php?branch=$1 [L,QSA]

# Rewrites /category/category-slug/ to /blog/category.php?slug=category-slug
RewriteRule ^category/([a-zA-Z0-9\-]+)/?$ blog/category.php?slug=$1 [L,QSA]

# Rewrites /tag/tag-slug/ to /blog/tag.php?slug=tag-slug
RewriteRule ^tag/([a-zA-Z0-9\-]+)/?$ blog/tag.php?slug=$1 [L,QSA]

# 3. Canonical Trailing Slash Enforcement (Important for SEO consistency)
# If a folder exists, ensure request has trailing slash to prevent duplicate content index issues
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 4. Gzip Compression (for Core Web Vitals Optimization)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>
